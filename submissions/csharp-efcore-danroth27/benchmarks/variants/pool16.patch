 /// <summary>GET /api/articles filters. Only the first one given applies, in this order.</summary>
 public record ArticleFilter(string? Tag, string? Author, string? Favorited)
 {
-    public IQueryable<Article> Apply(ConduitDb db)
+    public IQueryable<long> ApplyIds(ConduitDb db)
     {
-        if (!string.IsNullOrEmpty(Tag)) return db.Tags.Where(t => t.Name == Tag).SelectMany(t => t.Articles);
-        if (!string.IsNullOrEmpty(Author)) return db.Articles.Where(a => a.Author.Username == Author);
-        if (!string.IsNullOrEmpty(Favorited)) return db.Favorites.Where(f => f.User.Username == Favorited).Select(f => f.Article);
-        return db.Articles;
+        if (!string.IsNullOrEmpty(Tag))
+            return db.ArticleTags.Where(at => db.Tags.Where(t => t.Name == Tag).Select(t => t.Id).Contains(at.TagId))
+                .Select(at => at.ArticleId);
+        if (!string.IsNullOrEmpty(Author))
+            return db.Articles.Where(a => db.Users.Where(u => u.Username == Author).Select(u => u.Id).Contains(a.AuthorId))
+                .Select(a => a.Id);
+        if (!string.IsNullOrEmpty(Favorited))
+            return db.Favorites.Where(f => db.Users.Where(u => u.Username == Favorited).Select(u => u.Id).Contains(f.UserId))
+                .Select(f => f.ArticleId);
+        // Oldest rows are more likely to remain all-visible for the capped count.
+        return db.Articles.OrderBy(a => a.Id).Select(a => a.Id);
     }
 }
 
